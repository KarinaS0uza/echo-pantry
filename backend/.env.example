# Copy to backend/.env and replace both placeholders with locally generated secrets.
# config.environment.load_environment() explicitly reads backend/.env.
DJANGO_SECRET_KEY=replace-with-a-locally-generated-django-secret
SIMPLE_JWT_SIGNING_KEY=replace-with-a-locally-generated-jwt-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_DEBUG=true

# Optional absolute path for a separate restore drill. Omit for backend/db.sqlite3.
# SQLITE_PATH=/absolute/path/to/echo-pantry/backups/restore-drill.sqlite3
